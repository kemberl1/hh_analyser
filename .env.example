# === Database ===
POSTGRES_USER=hh_analyser
POSTGRES_PASSWORD=changeme
POSTGRES_DB=hh_analyser
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://hh_analyser:changeme@db:5432/hh_analyser

# === Backend ===
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# === LLM (Phase 6+) ===
API_KEY=your-api-key-here
LLM_BASE_URL=https://api-copilot.x5.ru/aigw/v1/
LLM_MODEL=x5-airun-medium
LLM_ENABLED=true
# Custom CA bundle (PEM) for the X5 CoPilot TLS chain. X5 uses an internal
# corporate CA (RootCA → sre-vault.x5.ru) that is NOT in the public certifi
# bundle, so TLS verification fails without this. Bundle shipped in image at
# /app/certs/x5_root_ca.pem. Leave empty to use default certifi trust store.
LLM_CA_BUNDLE=/app/certs/x5_root_ca.pem
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3
LLM_CACHE_TTL=3600
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.4

# === Scheduler (Phase 3) ===
SCHEDULER_CRON_HOUR=3
SCHEDULER_CRON_MINUTE=0
SCHEDULER_TIMEZONE=Europe/Moscow
SCHEDULER_MAX_PAGES=
SCHEDULER_MISFIRE_GRACE_TIME=3600

# === Phase 2: Parser / Crawler ===
HH_SOURCE=html
HH_API_FALLBACK_ENABLED=false
HH_USER_AGENT=HHAnalyserBot/1.0 (contact: hh-analyser@example.com)
HH_REQUEST_DELAY_MIN=1.5
HH_REQUEST_DELAY_MAX=3.5
HH_RATE_LIMIT_RPS=1.0
HH_MAX_PAGES=20
HH_ITEMS_PER_PAGE=20
HH_BASE_URL=https://hh.ru
HH_SEARCH_PATH=/search/vacancy
# HH_SEARCH_PARAMS={"text":"frontend developer","area":"113","per_page":"20"}
# HTML_SELECTORS=... (JSON, see config.py for defaults)

# === Phase 2: Relevance Filter ===
RELEVANCE_THRESHOLD=0.0
RELEVANCE_HARD_STOP_ON_TITLE=true
RELEVANCE_TITLE_WEIGHT_MULTIPLIER=3.0
RELEVANCE_AUDIT_ENABLED=true

# === Phase 2: Salary Normalization ===
NDFL_RATE=0.13

# === Frontend ===
VITE_API_URL=http://localhost:8000
